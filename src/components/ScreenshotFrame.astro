---
import Icon from "./Icon.astro";
import { screenshots, type ScreenshotKey } from "../data/showcase";
interface Props {
  name: ScreenshotKey;
  compact?: boolean;
}
const { name, compact = false } = Astro.props;
const shot = screenshots[name];
---

<figure class:list={["screenshot-figure", { "compact-shot": compact }]}>
  <div class="screenshot-mat">
    <div class="screenshot-label">
      <span>{shot.title}</span>
      <span>{shot.placeholder ? "SCREENSHOT PLACEHOLDER" : "IN DEVCROFT"}</span>
    </div>
    <button
      class="screenshot-open"
      data-screenshot={name}
      aria-label={`Enlarge ${shot.title.toLowerCase()}${shot.placeholder ? " placeholder" : " screenshot"}`}
    >
      <img
        src={shot.src}
        alt={shot.alt}
        width={compact ? 1040 : 2080}
        height={compact ? 520 : 900}
        loading="lazy"
      />
      {shot.annotations.map((point, index) => (
        <span
          class="screenshot-pin"
          style={`--pin-x:${point.x}%;--pin-y:${point.y}%`}
          aria-hidden="true"
        >
          {index + 1}
        </span>
      ))}
      <span class="screenshot-enlarge">
        <Icon name="external" size={14} /> Enlarge
      </span>
    </button>
    {shot.annotations.length > 0 && (
      <ol class="screenshot-annotations">
        {shot.annotations.map((point) => (
          <li>{point.label}</li>
        ))}
      </ol>
    )}
  </div>
  {!compact && (
    <figcaption>
      {shot.placeholder
        ? "Illustrative preview · real app capture to follow"
        : "Captured in Devcroft"}
    </figcaption>
  )}
</figure>
<dialog
  class="screenshot-dialog"
  id={`screenshot-${name}`}
  aria-labelledby={`screenshot-title-${name}`}
>
  <div class="screenshot-dialog-top">
    <div>
      <h2 id={`screenshot-title-${name}`}>{shot.title}</h2>
      {shot.placeholder && (
        <p>Illustrative placeholder · not a real app capture</p>
      )}
    </div>
    <form method="dialog">
      <button aria-label="Close screenshot" autofocus>
        ×
      </button>
    </form>
  </div>
  <div class="screenshot-dialog-image">
    <img
      src={shot.src}
      alt={shot.alt}
      width={compact ? 1040 : 2080}
      height={compact ? 520 : 900}
      loading="lazy"
    />
    {shot.annotations.map((point, index) => (
      <span
        class="screenshot-pin"
        style={`--pin-x:${point.x}%;--pin-y:${point.y}%`}
        aria-hidden="true"
      >
        {index + 1}
      </span>
    ))}
  </div>
  {shot.annotations.length > 0 && (
    <ol class="screenshot-annotations">
      {shot.annotations.map((point) => (
        <li>{point.label}</li>
      ))}
    </ol>
  )}
</dialog>
