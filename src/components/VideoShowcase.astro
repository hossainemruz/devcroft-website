---
import Icon from "./Icon.astro";
import { demoVideo } from "../data/showcase";
---

<figure class="video-showcase" id="demo">
  <div class="video-frame">
    {demoVideo.src ? (
      <video
        controls
        playsinline
        preload="none"
        poster={demoVideo.poster}
        aria-label="Devcroft product walkthrough"
      >
        <source src={demoVideo.src} type="video/mp4" />
        {demoVideo.captions && (
          <track
            kind="captions"
            src={demoVideo.captions}
            srclang="en"
            label="English"
            default
          />
        )}
        Your browser does not support video playback.{" "}
        <a href={demoVideo.src}>Download the walkthrough</a>.
      </video>
    ) : (
      <>
        <img
          class="video-poster"
          src={demoVideo.poster}
          alt="Placeholder video poster showing an illustrated Devcroft workspace. The real app recording will appear here."
          width="2080"
          height="900"
          fetchpriority="high"
        />
        <div class="poster-shade"></div>
        <span class="media-preview-badge">VIDEO POSTER PLACEHOLDER</span>
        <button
          class="poster-play"
          aria-controls="video-placeholder-message"
          aria-expanded="false"
        >
          <span class="poster-play-icon">
            <Icon name="play" size={26} />
          </span>
          <span>
            Demo video coming soon
            <small>Preview the walkthrough layout</small>
          </span>
        </button>
        <div
          class="video-placeholder-message"
          id="video-placeholder-message"
          role="region"
          tabindex="-1"
          aria-labelledby="video-placeholder-title"
          aria-describedby="video-placeholder-description"
          hidden
        >
          <span class="eyebrow">A PLACE FOR THE REAL THING</span>
          <h3 id="video-placeholder-title">The walkthrough is coming.</h3>
          <p id="video-placeholder-description">
            This is a preview of the video layout. A real Devcroft recording
            will play here, with controls and sound only when you choose.
          </p>
          <button class="button button-small" id="close-video-message">
            Back to poster <Icon name="arrow" size={15} />
          </button>
        </div>
      </>
    )}
  </div>
  <figcaption>
    <span>
      <span class="live-dot"></span> A closer look at your next workspace.
    </span>
    <span>
      {demoVideo.src ? "PLAY AT YOUR OWN PACE" : "DEMO RECORDING COMING SOON"}
    </span>
  </figcaption>
</figure>
